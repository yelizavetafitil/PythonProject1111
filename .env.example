# Секрет подписи сессий портала. Сгенерировать: openssl rand -hex 32
PORTAL_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
# На сервере с HTTPS обязательно 1; для локального HTTP — 0.
SESSION_COOKIE_SECURE=1

# Active Directory. Пароль служебной учётной записи не хранить в Git.
LDAP_URI=ldap://192.168.0.4
LDAP_BASE_DN=DC=local,DC=energoprom,DC=by
LDAP_BIND_DN=CN=service-account,OU=Service,DC=local,DC=energoprom,DC=by
LDAP_BIND_PASSWORD=CHANGE_ME_service_account_password
LDAP_USER_ATTRIBUTE=sAMAccountName

# SMTP (если на портале используется отправка писем)
SMTP_HOST=192.168.0.28
SMTP_PORT=587
SMTP_USERNAME=robot-bnp
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_USE_TLS=1

# Интеграция с БелнипиAI
AI_ASSISTANT_PUBLIC_URL=https://ai.energoprom.by
AI_ASSISTANT_CALLBACK_URL=https://ai.energoprom.by/sso-login
# Должен полностью совпадать с AI_SSO_SHARED_SECRET в проекте БелнипиAI.
AI_SSO_SHARED_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
AI_SSO_MAX_AGE_SEC=300

# Табели. На Linux сетевой ресурс //srv-doc/ТАБЕЛЬ монтируется на хосте сюда,
# затем docker-compose передаёт его контейнеру только для чтения.
TABEL_HOST_MOUNT=/mnt/tabel
# Проверять наличие настоящего CIFS mount перед production-обновлением.
TABEL_REQUIRE_MOUNT=1
